<!DOCTYPE html>
<html lang="zh-cmn-Hans-CN">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="./index.css">
  <link rel="icon" href="favicon.ico" type="image/x-icon">
  <title>PicWall - Cheng&apos;s Gallery</title>
  <meta name="description" content="All photos by Cheng Gu">
</head>

<body>
  <header class="header">
    <nav class="nav">
      <div class="logo">
        <h1 id="title">Cheng&apos;s Gallery</h1>
      </div>
      <div class="nav-right">
        <ul class="links">
          <li class="link"><a class="link-a" href="https://guchengf.me">About</a></li>
        </ul>
      </div>
    </nav>
  </header>
  <div class="photos" id="photos">
    @each(photo in photos)
    <a class="photo" href="{{photo[1].src}}" data-pswp-width="{{photo[1].ImageWidth}}"
      data-pswp-height="{{photo[1].ImageHeight}}">
      <picture class="photo-picture">
        <img class="photo-image" src="{{photo[1].thumbnail}}" height={{255 / photo[1].ImageWidth * photo[1].ImageHeight}} loading="lazy"><span class="pswp-caption-content">
          <p>设备：{{photo[1].Model}}</p>
          <p>镜头：{{photo[1].Lens}}</p>
          <p>光圈：{{photo[1].Aperture}}</p>
          <p>快门：{{photo[1].ShutterSpeed}}</p>
          <p>ISO：{{photo[1].ISO}}</p>
          <p>焦距：{{photo[1].FocalLength}}</p>
          <p>拍摄时间：{{photo[1].createDate}}</p>
        </span>
      </picture>
    </a>
    @end
  </div>
  <footer class="footer">
    <div>
      <p>Copyright &copy; 2025 Cheng Gu</p>
    </div>
  </footer>
  <script src="./index.js"></script>

</body>

</html>
